APP_NAME="Hope Media RDC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Kinshasa

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# APIs Réseaux Sociaux — Synchronisation automatique du contenu
# =============================================================================

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# Obtenir une clé : https://console.cloud.google.com/ → APIs → YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=@votre-handle
YOUTUBE_MAX_RESULTS=10

# ── Facebook Graph API (Page) ─────────────────────────────────────────────────
# 1. Créer une app : https://developers.facebook.com/
# 2. Ajouter le produit "Pages API"
# 3. Générer un Page Access Token (long-lived, 60 jours ou permanent avec system user)
#    via : Graph API Explorer → choisir votre Page → Générer le token
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_MAX_RESULTS=20

# ── Instagram Graph API (Business / Creator) ──────────────────────────────────
# Prérequis : compte Instagram Business relié à une Page Facebook
# 1. Même app Facebook que ci-dessus
# 2. Ajouter le produit "Instagram Graph API"
# 3. Permission requise : instagram_basic
# INSTAGRAM_USER_ID : ID numérique du compte IG (ex: 17841400008460056)
#   → Obtenir via : GET /me?fields=instagram_business_account&access_token=...
# INSTAGRAM_ACCESS_TOKEN : Long-lived token (valable 60 jours, renouvelable)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MAX_RESULTS=20

# ── TikTok Content API v2 ─────────────────────────────────────────────────────
# 1. Créer une app : https://developers.tiktok.com/
# 2. Activer Login Kit + scopes : video.list, user.info.basic
# 3. Faire passer le propriétaire du compte TikTok par le flux OAuth 2.0
#    → Récupérer access_token, refresh_token et open_id
# TIKTOK_ACCESS_TOKEN  : expire après 24h (renouvelable via refresh_token)
# TIKTOK_REFRESH_TOKEN : expire après 365 jours
# TIKTOK_OPEN_ID       : identifiant unique de l'utilisateur TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_MAX_RESULTS=20

